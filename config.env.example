# Kenniscapture — configuratie
# Pas dit bestand aan per machine. Wordt NIET gecommit (staat in .gitignore).

# ── Netwerk ──────────────────────────────────────────────────────────
# 0.0.0.0  = bereikbaar via het netwerk (gebruik dit op de 105)
# 127.0.0.1 = alleen lokaal (eigen laptop)
HOST=127.0.0.1

PORT_BACKEND=8000
PORT_STREAMLIT=8501
PORT_CHATBOT=5173

# ── Ollama model ─────────────────────────────────────────────────────
# llama3.1:8b  = beste kwaliteit, trager op CPU  (~15-30 sec/antwoord)
# llama3.2:3b  = sneller, iets minder nauwkeurig (~5-10 sec/antwoord)
OLLAMA_MODEL=llama3.1:8b

# ── Paden ────────────────────────────────────────────────────────────
DATABASE_PATH=../data/kennisbank.db
UPLOAD_DIR=../uploads

# ── Extra CORS origins ───────────────────────────────────────────────
# Op de 105 met HOST=0.0.0.0: voeg het server-IP toe zodat andere
# apparaten op het netwerk toegang krijgen tot de API.
# CORS_ORIGINS=http://192.168.4.105:5173,http://192.168.4.105:8501
CORS_ORIGINS=

# ── Automatisch opstarten bij Windows-start ──────────────────────────
# true  = registreer als Windows Taakplanner-taak (start bij elke herstart)
# false = alleen handmatig starten via start.sh
AUTOSTART=false